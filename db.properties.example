# Database Configuration Properties Template for PHAROAH
# Copy to db.properties or set environment variables DB_URL, DB_USER, DB_PASSWORD.

db.type=mysql
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://127.0.0.1:3306/pharoah_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
db.user=root
db.password=YOUR_MYSQL_PASSWORD_HERE

# Fallback SQLite URL if MySQL server is stopped
db.fallback.sqlite=jdbc:sqlite:pharoah.db
